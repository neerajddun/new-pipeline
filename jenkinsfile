pipeline {

    agent any 

    environment {

        maven 'Maven 3.9.9'

        jdk 'jdk 21'
    }

    stages {

        stage ('Checkout') {

            steps {

                checkout scm
            }
        }

        stage ('Unit Test') {

            steps {

                sh 'mvn test'
            }
        }

        stage ('Integration Test') {

            steps {

                sh 'mvn verify'
            }
        }

        stage ('build') {

            steps {

                sh 'mvn clean install'
            }
        }
    }
}