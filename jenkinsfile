pipeline {

    agent any 

    tools {

        maven 'Maven 3.9.9'

        jdk 'jdk 21'
    }

    stages {

        stage ('Checkout') {

            steps {

                checkout scm
            }
        }

        stage ('Unit Test') {

            steps {

                sh 'mvn test'
            }
        }

        stage ('Integration Test') {

            steps {

                sh 'mvn verify'
            }
        }

        stage ('build') {

            steps {

                sh 'mvn clean install'
            }
        }

        stage ('Docker image') {

            steps {

                sh '''

                docker build -t ${JOB_NAME}:v1.${BUILD_NUMBER} .
                docker tag  ${JOB_NAME}:v1.${BUILD_NUMBER} neeraj91/ ${JOB_NAME}:v1.${BUILD_NUMBER}
                docker tag  ${JOB_NAME}:v1.${BUILD_NUMBER} neeraj91/ ${JOB_NAME}:latest
            
            '''

            }
        }

        stage ('Docker push') {

            steps {

                script {
                     
                     withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', passwordVariable: 'Dockervars', usernameVariable: 'Dockername')]) {
                     
                     sh '''

                     docker login -u $Dockername -p $Dockervars

                     docker push neeraj91/ ${JOB_NAME}:v1.${BUILD_NUMBER}


                     docker push neeraj91/ ${JOB_NAME}:latest
                     
                     '''
                    }

                }
            }
        }

        stage ('Deploy'){

            steps {

                sh 'echo Deploy'
            }
        }
     }

     post {

        always {

            cleanWs()
        }
     }
}